# Креды и локальные настройки devflow. Положить в ~/.claude/devflow/.env (права 600).
# Переопределить путь: переменная окружения DEVFLOW_ENV.

# YouTrack: адрес инстанса без /api, например https://example.youtrack.cloud
YOUTRACK_URL=
# Постоянный токен YouTrack (perm:…, как выпустить: https://www.jetbrains.com/help/youtrack/cloud/manage-permanent-token.html) — для скачивания вложений (tracker attachments).
# Тот же токен подходит для подключения MCP-сервера YouTrack (см. INSTALL.md).
YOUTRACK_TOKEN=
# Ключ проекта по умолчанию (тикеты вида T-123)
YOUTRACK_PROJECT=T

# Рабочая копия репозитория плагина — сюда пишут /devflow:rule и /devflow:retro
DEVFLOW_SRC=~/dev/devflow
